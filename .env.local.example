MONGODB_URI=mongodb+srv://USUARIO:PASSWORD@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=mitech

# Puente de solo lectura hacia Cubicaje — "Pedidos en vivo" (/pedidos-live)
# YA NO se conecta directo a BinManagerRO ni a la API de pallets del WMS
# (Vercel no puede alcanzar esa IP fija por firewall, y no debe guardar
# credenciales de la empresa). Todo pasa por GET /api/integrations/live-orders
# de Cubicaje. NUNCA prefijar estas variables con NEXT_PUBLIC_/VITE_ — solo
# se leen en Route Handlers de servidor (lib/cubicajeClient.js).
# CUBICAJE_INTEGRATION_KEY debe coincidir EXACTAMENTE con
# ORDERS_INTEGRATION_KEY del lado de Cubicaje (Coolify).
CUBICAJE_API_URL=https://cubicaje.mi2.com.mx
CUBICAJE_INTEGRATION_KEY=

# Integración Cubicaje → Pedidos (M2M, solo lectura desde Cubicaje hacia
# este endpoint). Secreto compartido validado en el header X-Integration-Key
# por POST /api/integrations/cubicaje/pallets. Nunca se envía al frontend.
CUBICAJE_PEDIDOS_INTEGRATION_KEY=

# Integración de SOLO LECTURA hacia afuera (M2M): otros proyectos (ej.
# mitechnologies-rt) pueden listar pedidos reales via GET
# /api/integrations/pedidos con header X-Integration-Key. Preparado
# 2026-08-06, sin consumidor conectado todavía.
MITECHNOLOGIES_INTEGRATIONS_KEY=
