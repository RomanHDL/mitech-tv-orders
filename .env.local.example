# App
PORT=3000

# PostgreSQL 16 (Coolify provisiona una instancia por app en dev/prod)
DATABASE_URL=postgres://usuario:password@host:5432/mitech_tv_orders

# Sesión (connect-pg-simple). Genera un valor largo y aleatorio por entorno.
SESSION_SECRET=

# OIDC Nextcloud — inyectado por `provision-app-sso mitech-tv-orders`
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=https://mitech-tv-orders.mi2.com.mx/auth/callback

# WMS (SQL Server solo-lectura) — pedidos en vivo en /pedidos-live.
# Ojo: la base es BinManagerRO (réplica RO), NO BinManager.
SQLSERVER_HOST=45.22.197.136
SQLSERVER_PORT=1433
SQLSERVER_USER=usuario.solo.lectura
SQLSERVER_PASSWORD=CAMBIAR_ESTA_CONTRASENA
SQLSERVER_DB=BinManagerRO

# API de pallets del WMS (drill-down de ubicación/movimientos)
PALLET_API_URL=https://appsc.mitechnologiesinc.com

# Observabilidad (provisionado por `provision-app-sentry mitech-tv-orders`)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_ENVIRONMENT=development
